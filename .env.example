# Trakt2Letterboxd environment variables

# Required: the target user's public Trakt profile name.
TRAKT_USERNAME=

# The supplied public API key is already the script default. Set this only when
# intentionally overriding the default key for a local or CI environment.
TRAKT_CLIENT_ID=0128c95089a7b58477204806a1b62ee130182b48c121c1eb9fe1d37b915fc5cb

# --- Letterboxd session cookie (only needed for the upload step).
LETTERBOXD_SESSION_COOKIE=
